<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <TextView
            android:text="Personal Records"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#999999"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


        <TextView
            android:id="@+id/txtGender"
            android:text="Gender: --"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <TextView
            android:id="@+id/txtWeight"
            android:text="Weight: --"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <TextView
            android:id="@+id/txtWakeup"
            android:text="Wake-up Time: --"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <TextView
            android:id="@+id/txtBedtime"
            android:text="Bed Time: --"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <TextView
            android:id="@+id/txtTarget"
            android:text="Daily Target: --"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:background="#E3F2FD"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <TextView
            android:id="@+id/txtInterval"
            android:text="Reminder Interval: --"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:background="#E3F2FD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>