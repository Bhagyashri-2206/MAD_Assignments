<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ✅ Permissions MUST be outside application -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AquaRitual"
        tools:targetApi="31">
        <activity
            android:name=".activities.SettingActivity"
            android:exported="false" />
        <activity
            android:name=".activities.HistoryActivity"
            android:exported="false" />
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false" /> <!-- 🔹 Launcher / Router -->
        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- 🔹 Onboarding Activities -->
        <activity
            android:name=".activities.GenderActivity"
            android:exported="false" />
        <activity
            android:name=".activities.WeightActivity"
            android:exported="false" />
        <activity
            android:name=".activities.WakeUpActivity"
            android:exported="false" />
        <activity
            android:name=".activities.BedTimeActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ResultActivity"
            android:exported="false" /> <!-- 🔹 Other Activities -->

        <receiver
            android:name=".receiver.WaterReminderReceiver"
            android:exported="false"/>

        <receiver
            android:name=".receiver.DismissReceiver"
            android:exported="false"/>

    </application>

</manifest>